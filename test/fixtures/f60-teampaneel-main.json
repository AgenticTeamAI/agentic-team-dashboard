  "metBeheer": "<div id=\"panel-team-namen-body\" data-team-beheer=\"true\">\n      <form class=\"team-uitnodigen\" data-team-uitnodigen=\"\" novalidate=\"\">\n      <p class=\"team-uitnodigen-kop\"><strong>Iemand uitnodigen</strong></p>\n      <div class=\"team-uitnodigen-rij\">\n        <label class=\"bedien-veld\"><span>Naam</span>\n          <input id=\"team-uitnodig-naam\" type=\"text\" autocomplete=\"off\" maxlength=\"80\" placeholder=\"Voornaam Achternaam\" data-team-uitnodig-naam=\"\"></label>\n        <label class=\"bedien-veld\"><span>E-mailadres</span>\n          <input id=\"team-uitnodig-adres\" type=\"email\" autocomplete=\"off\" maxlength=\"254\" placeholder=\"naam@bedrijf.nl\" data-team-uitnodig-adres=\"\"></label>\n        <button type=\"submit\">Uitnodigen</button>\n      </div>\n      <p class=\"footnote\">Diegene krijgt een mail met uitleg en kan daarna inloggen met dit adres. De naam zie je terug bij wat je collega oppakt.</p>\n    </form>\n      <p class=\"footnote team-melding\" data-team-melding=\"\" aria-live=\"polite\"></p>\n      <p class=\"footnote warn team-melding\" data-team-let-op=\"\" aria-live=\"polite\"></p>\n      <p class=\"bewerk-fout team-melding\" data-team-fout=\"\" role=\"alert\"></p>\n      <div data-team-lijst=\"\"><p class=\"footnote\">De naam komt in <strong>Eigenaar</strong> en <strong>Afgerond door</strong>\n      te staan. Pas hem aan en klik ernaast om op te slaan.</p>\n    <div class=\"tabel-scroll\">\n      <table class=\"detail-table team-tabel\">\n        <thead><tr><th>Naam</th><th>E-mailadres</th><th>Status</th><th>Toegang</th></tr></thead>\n        <tbody><tr>\n    <td><input class=\"team-naam\" type=\"text\" maxlength=\"80\" value=\"Tijmen\" data-team-seat=\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" aria-label=\"Weergavenaam van tijmen@voorbeeld.nl\"></td>\n    <td class=\"footnote\">tijmen@voorbeeld.nl</td>\n    <td class=\"footnote\">actief</td>\n    <td class=\"team-actie\"><span class=\"footnote\" title=\"De eigenaar van de licentie kun je niet verwijderen.\">licentiehouder</span></td>\n  </tr><tr>\n    <td><input class=\"team-naam\" type=\"text\" maxlength=\"80\" value=\"janine\" data-team-seat=\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\" aria-label=\"Weergavenaam van janine@klant.nl\"></td>\n    <td class=\"footnote\">janine@klant.nl</td>\n    <td class=\"footnote\">actief</td>\n    <td class=\"team-actie\"><button type=\"button\" class=\"team-verwijder\" data-team-verwijder=\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\" aria-label=\"janine@klant.nl verwijderen\">Verwijderen</button></td>\n  </tr><tr>\n    <td><input class=\"team-naam\" type=\"text\" maxlength=\"80\" value=\"piet\" data-team-seat=\"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\" aria-label=\"Weergavenaam van piet@klant.nl\"></td>\n    <td class=\"footnote\">piet@klant.nl</td>\n    <td class=\"footnote\">uitgenodigd, nog niet ingelogd</td>\n    <td class=\"team-actie\"><button type=\"button\" class=\"team-verwijder\" data-team-verwijder=\"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\" aria-label=\"piet@klant.nl verwijderen\">Verwijderen</button></td>\n  </tr><tr>\n    <td><input class=\"team-naam\" type=\"text\" maxlength=\"80\" value=\"bea\" data-team-seat=\"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\" aria-label=\"Weergavenaam van bea@klant.nl\"></td>\n    <td class=\"footnote\">bea@klant.nl</td>\n    <td class=\"footnote\">actief</td>\n    <td class=\"team-actie\"><button type=\"button\" class=\"team-verwijder\" data-team-verwijder=\"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\" aria-label=\"bea@klant.nl verwijderen\">Verwijderen</button></td>\n  </tr></tbody>\n      </table>\n    </div></div></div>",
